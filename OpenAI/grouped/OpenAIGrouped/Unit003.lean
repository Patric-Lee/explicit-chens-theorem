  intro ι _ p hp _ hcop hg hinj
    R hR s T q w B lengthScale F Ψ₁ Ψ₂ m z ud ue uv kap X₁ X₂ hq hB hL hs hfixed hmap ht hn hw
  obtain ⟨b,hb,htrans⟩ := htransfer R hR
