    Real.continuous_sqrt.comp (((b.continuous.norm.mul_const ‖a‖).mul
      (rayIdealEnergy_continuous p hg F C₁ hc₁ true h)))
  have hg' : Continuous g :=
    Real.continuous_sqrt.comp (((b.continuous.norm.mul_const ‖a‖).mul
      (rayIdealEnergy_continuous p hg F C₂ hc₂ false h)))
