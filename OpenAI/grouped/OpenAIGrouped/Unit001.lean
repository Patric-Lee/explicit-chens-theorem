    0 ≤ firstColumnEnergy p hp hcop hg F B v ε₁ ε₂ negative C V X d h b := by
  apply integral_nonneg
  intro t
  exact mul_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    (rayIdealEnergy_nonneg _ _ _ _ _ _)

