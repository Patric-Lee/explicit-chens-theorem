        star (finiteSquarefreeRow P hg (S \ T) h)) *
      (finiteSquarefreeRow P hg (T \ S) d *
        star (finiteSquarefreeRow P hg (T \ S) h)) := by
  dsimp only
  rw [finiteSexticRow_activeSupport, finiteSexticRow_activeSupport]
  simp only [star_mul, star_star]
  ring

