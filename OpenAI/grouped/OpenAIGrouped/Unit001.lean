theorem secondChildSum_uniform_bound
    (F V : Finset ι) (Ψ : O →* ℂ) (m r c d e k : O)
    (H : ℝ → Finset ι → ℂ) (hn : ∀ t S, ‖H t S‖ = ‖H 0 S‖) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ t,
      ‖secondChildSum p hp hcop hg F V Ψ m r c d e k (H t)‖ ≤ M := by
  refine ⟨∑ N ∈ (F \ V).powerset,
