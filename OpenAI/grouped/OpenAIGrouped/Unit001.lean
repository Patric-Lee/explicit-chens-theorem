theorem first_element_fiber_small_power (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ (s : Finset (Ideal O × O)),
      (∀ x ∈ s, Squarefree x.1) → ∀ e y : O, y ≠ 0 →
