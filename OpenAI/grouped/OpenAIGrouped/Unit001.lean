theorem idealSupport_active_conductor_mul_common_sq
    (F : Finset (Ideal O)) {I J : Ideal O} (hI : I ∈ F) (hJ : J ∈ F)
    (hsI : Squarefree I) (hsJ : Squarefree J) :
    (∏ i ∈ activeSupport (idealSupport F I) (idealSupport F J), i.val) *
