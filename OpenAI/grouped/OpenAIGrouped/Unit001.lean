theorem quadraticRow_pair_kernel {α : Type*} [DecidableEq α]
    (P : α → Ideal O) [∀ i, (P i).IsMaximal]
    (hg : ∀ i, lambda ∉ P i) (S T : Finset α) (z : O) :
    star (quadraticRow P hg S z) * quadraticRow P hg T z =
