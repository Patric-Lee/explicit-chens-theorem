      apply Finset.sum_congr rfl
      intro D hD
      rw [supportConjugateSum_star_ray_common p hg B D C₁ r.1 h,
        supportConjugateSum_ray_common p hg B D C₂ r.2 h]
      simp only [star_mul, star_star]
