      densityChildEnergy p hp hcop hg F Ψ₁ Ψ₂ (m*∏ i ∈ A,p i) T V₁ V₂ X₁ X₂ J := by
  simp only [densityChildEnergy,childGeometricMean_fixed_pool p hp hcop hg hinj]

