lemma rectangle_interval_swap (f : ℝ→ℝ→ℂ) (hf : Continuous f.uncurry) :
    (∫y in (0:ℝ)..(3*Real.sqrt 3), ∫x in (0:ℝ)..3, f x y)=
      ∫x in (0:ℝ)..3, ∫y in (0:ℝ)..(3*Real.sqrt 3), f x y := by
