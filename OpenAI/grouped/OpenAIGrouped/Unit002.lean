        ((volume.restrict (Set.Icc 0 (3*Real.sqrt 3))).prod (volume.restrict (Set.Icc 0 3))) := by
      simpa only [Measure.prod_restrict,← Measure.volume_eq_prod,IntegrableOn] using hi
