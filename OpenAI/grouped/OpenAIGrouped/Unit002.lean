  have hj := secondLogIndex_mem_box p hp D X M Kmax x hs hE hk0 (hK x hx)
  rw [Finset.sum_eq_single_of_mem (secondLogIndex p D x) hj]
  · simp
  · intro j hj hne
    simp [Ne.symm hne]

