    (hML : M ≤ (2 : ℝ) ^ lengthScale) (hN : 1 ≤ N) (hG : 0 < G) (ε : ℝ) (hε : 0 < ε) :
    highKernelNorm M N K ≤ 16 * ∑ j ∈ Finset.range (lengthScale + 1),
