    (hmeanAbsorb : Cmean ≤ (D : ℝ) ^ eta)
    (hcountAbsorb : 1 ≤ Ccount * (D : ℝ) ^ eta) :
    ‖∑ n ∈ Finset.Icc 1 D,
        FiniteSFactor.outsideCoeff S (baseChangeWeight χ) n * W n‖ ≤
      384 * (D : ℝ) ^ ((23 / 24 : ℝ) + (ε + eta)) := by
