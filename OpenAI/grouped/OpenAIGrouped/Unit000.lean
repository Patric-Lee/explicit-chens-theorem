      ∀ x : ℝ, 0 < x →
        (1 + x) ^ A₂ * ‖eulerDeriv F₂ i x‖ ≤ CF₂) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ R₁ R₂ : ℝ, 0 < R₁ → 0 < R₂ →
        ∃ (b₁ b₂ : ℝ → ℂ),
          (∀ y : ι → ℝ,
            (∏ j : ι, W j (y j)) *
              F₁ (R₁ * Real.exp (∑ j : ι, a₁ j * y j)) *
              F₂ (R₂ * Real.exp (∑ j : ι, a₂ j * y j)) =
            ∫ t₁ : ℝ, (∫ t₂ : ℝ,
              (∏ j : ι, W j (y j)) *
                FourierBridge.logPhase t₁ (∑ j : ι, a₁ j * y j) *
                FourierBridge.logPhase t₂ (∑ j : ι, a₂ j * y j) *
                b₂ t₂) * b₁ t₁) ∧
          ((1 + R₁) ^ A₁ * (1 + R₂) ^ A₂) *
            ((∫ t₁ : ℝ, (1 + ‖t₁‖) ^ J₁ * ‖b₁ t₁‖) *
