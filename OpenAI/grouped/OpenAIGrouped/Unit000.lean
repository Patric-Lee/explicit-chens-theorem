  rw [heq]
  simpa only [smul_eq_mul, add_neg_cancel] using
    (mellin_cpow_smul (fun y : ℝ => (bump y : ℂ)) ρ (-ρ))

noncomputable def weightedBump (y : ℝ) : ℝ :=
  bump y / positiveExtension y

