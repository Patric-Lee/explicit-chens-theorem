noncomputable def rowNormBall (H : ℕ) : Finset O := by
  classical
  let I : Finset ℤ := Finset.Icc (-((H : ℤ) + 1)) ((H : ℤ) + 1)
  exact (I.product I).image (fun v => eval v.1 v.2)

theorem mem_rowNormBall_of_qNat_le (H : ℕ) (u : O)
    (h : qNat u ≤ H) : u ∈ rowNormBall H := by
