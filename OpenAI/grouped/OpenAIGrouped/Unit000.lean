  rw [columnsUpTo, Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro I hI
    exact columnWeight_idealGenerator χ W I
  · intro I hI J hJ h
    exact idealGenerator_injective h

noncomputable def goodLambda : O :=
