theorem gauss_transform_finite_ideal_crt {ι A : Type*} [Fintype ι] [CommRing A]
    (P : ι → Ideal A) (hc : Pairwise (Function.onFun IsCoprime P))
    [∀ i, (P i).IsMaximal]
