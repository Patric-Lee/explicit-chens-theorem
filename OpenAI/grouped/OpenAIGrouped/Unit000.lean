theorem eventually_absorb_MS_and_count_constants
    (Cmean Ccount eta : ℝ) (hcount : 0 < Ccount) (heta : 0 < eta) :
    ∃ D₀ : ℕ, ∀ D : ℕ, D₀ ≤ D →
      Cmean ≤ (D : ℝ) ^ eta ∧ 1 ≤ Ccount * (D : ℝ) ^ eta := by
