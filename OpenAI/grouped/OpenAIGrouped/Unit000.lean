theorem concrete_fixed_phase_congr (d a b x : eisensteinSubring)
    (hd : d ≠ 0) (hcong : d ∣ a - b) :
    breveE ((a : ℂ) * (x : ℂ) / ((lamEis : ℂ) * (d : ℂ))) =
      breveE ((b : ℂ) * (x : ℂ) / ((lamEis : ℂ) * (d : ℂ))) := by
