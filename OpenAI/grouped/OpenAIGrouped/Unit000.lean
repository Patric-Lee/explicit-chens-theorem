private theorem fiber_card_natCard (n : ℕ) :
    (fiber n).card = Nat.card {I : Ideal O // Ideal.absNorm I = n} := by
  change (Ideal.finite_setOfPred_absNorm_eq (S := O) n).toFinset.card =
    Set.ncard {I : Ideal O | Ideal.absNorm I = n}
