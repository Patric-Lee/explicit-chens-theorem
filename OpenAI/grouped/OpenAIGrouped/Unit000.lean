theorem weight_smooth (ρ : ℂ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (weight ρ) := by
  have hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun y : ℝ => (bump y : ℂ)) := by
