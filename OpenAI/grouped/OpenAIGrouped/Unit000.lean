    have hphase₂ (t : ℝ) :
        (∏ j : ι, W j (y j) * FourierBridge.logPhase t (a₂ j * y j)) =
          P * FourierBridge.logPhase t s₂ := by
      rw [Finset.prod_mul_distrib]
      simp only [P, s₂]
      congr 1
      simpa using (FourierBridge.logPhase_sum (Finset.univ : Finset ι) t
        (fun j => a₂ j * y j)).symm
    have hsep₁' : P * Z₁ =
