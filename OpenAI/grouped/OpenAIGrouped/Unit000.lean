    sixth_power_eq_implies_same_prime_ideal (p i) (p j)
      (hgen i hi ▸ hprime i hi)
      (hgen j hj ▸ hprime j hj) heq
  apply hinj hi hj
  rw [hgen i hi, hgen j hj]
  exact hsame

