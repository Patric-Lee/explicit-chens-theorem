      rw [MulChar.inv_apply']
      simp
    _ = gaussSum ((χ ^ 2)⁻¹) (ψ.mulShift a) := by
      rw [gaussSum_eq_units_sum]
      simp only [AddChar.mulShift_apply]

theorem direct_theta_active_zero_fourier_row (χ : MulChar F ℂ)
    (ψ : AddChar F ℂ) (hχ₂ : χ ^ 2 ≠ 1)
    (σ : Fˣ) (ε x : F) :
