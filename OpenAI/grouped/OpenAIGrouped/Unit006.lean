  obtain ⟨u,m,I,J,hsq,hI,hJ,hfactor⟩:=
    sourceResidualFourierCoefficient_full_squarefree_cube_support h hh hn
  refine ⟨(u,m,(⟨I,hsq,hI⟩,⟨J,hJ⟩)),?_⟩
