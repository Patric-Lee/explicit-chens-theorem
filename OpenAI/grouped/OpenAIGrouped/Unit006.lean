      complexMatrix (upperTranslation (ActualEisensteinCoordinates.eval A B)) • upperPoint z v hv :=
    congrArg (fun g : SL(2,ℂ)=>(g:HyperbolicSpace))
      (upperTranslation_section (ActualEisensteinCoordinates.eval A B) z v hv).symm
