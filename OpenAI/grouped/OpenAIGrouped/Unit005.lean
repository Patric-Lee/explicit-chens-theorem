    positiveHeightPower,logRatioPower,Real.log_one,sub_zero,ContinuousMap.coe_mk]

lemma compactHeightProfile_seed (a b B : ℝ) (ha : 0<a) (hab : a<b) (hB : a≤B)
    (s : ℂ) (v : ℝ) (hv : v≤B) :
