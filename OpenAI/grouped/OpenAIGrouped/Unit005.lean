  have hΨ : ∀u,‖normHeightTwist Ψ oldHeight u‖≤1 :=
    fun u=>(normHeightTwist_norm_le Ψ oldHeight u).trans (hstate.coefficient.norm_le hbase u)
  have hcoeff : ∀I∈labels,∀v∈Q',‖β I v‖≤Cg*Z^(3*ε) := by
    intro I hI v hv
