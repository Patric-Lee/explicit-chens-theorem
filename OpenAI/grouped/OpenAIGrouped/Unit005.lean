      _ ≤ Real.exp 1*(Real.exp A*Z^3) := by gcongr
      _ = _ := by rw [Real.exp_add];ring
  have hbgrowth : (Real.exp 1*B)^ε≤(Real.exp (A+1))^ε*Z^(3*ε) := by
    calc
