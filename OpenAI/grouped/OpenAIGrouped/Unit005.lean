      mul_le_mul_of_nonneg_left he (Real.rpow_nonneg ht.le _)
    _ = _ := by rw [sub_eq_add_neg,Real.exp_add]; ring_nf

lemma cubicBesselIntegral_upper (x : ℝ) :
    (∫t in Set.Ioi (0:ℝ),cubicBesselDensity x t)≤
