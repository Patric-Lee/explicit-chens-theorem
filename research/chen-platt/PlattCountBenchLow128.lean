import PlattReciprocalKernel
namespace ChenEffective.PlattWindow
set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem count_Low128 : Nat.beq (segmentCounts 4000001 4 128)  = true := by
  decide +kernel
theorem reject_Low128 : Nat.beq (segmentCounts 4000001 4 128)  = false := by
  rw [Nat.eq_of_beq_eq_true count_Low128]
  decide +kernel
